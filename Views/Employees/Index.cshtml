@model IEnumerable<EmpMaster.Models.EmployeeViewModel>

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="search" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name or title" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
    <a class="btn btn-info ms-2" asp-action="TitleList">Title List</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]">Name</a>
            </th>
            <th>SSN</th>
            <th>DOB</th>
            <th>City</th>
            <th>Phone</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["TitleSortParm"]">Current Title</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["SalarySortParm"]">Current Salary</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @{
        var snCurrentPage = (int)ViewData["CurrentPage"];
        var snPageSize = (int)ViewData["PageSize"];
        var startIndex = (snCurrentPage - 1) * snPageSize;
        var row = 0;
    }
    @foreach (var item in Model)
    {
        <tr>
            <td>@(startIndex + (++row))</td>
            <td>@item.Name</td>
            <td>@item.Ssn</td>
            <td>@item.Dob.ToString("yyyy-MM-dd")</td>
            <td>@item.City</td>
            <td>@item.Phone</td>
            <td>@(string.IsNullOrEmpty(item.CurrentTitle) ? "-" : item.CurrentTitle)</td>
            <td>@(item.CurrentSalary.HasValue ? item.CurrentSalary.Value.ToString("C") : "-")</td>
            <td>@(item.AverageTitleSalary.HasValue ? item.AverageTitleSalary.Value.ToString("C") : "-")</td>
            <td>@item.SalaryDifferenceDisplay</td>
            <td>
                <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@{
    var currentPage = (int)ViewData["CurrentPage"];
    var totalPages = (int)ViewData["TotalPages"];
    var pageSize = (int)ViewData["PageSize"];
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage==1?"disabled":"")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage-1)" asp-route-pageSize="@pageSize" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Previous</a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p==currentPage?"active":"")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@pageSize" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">@p</a>
                </li>
            }
            <li class="page-item @(currentPage==totalPages?"disabled":"")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage+1)" asp-route-pageSize="@pageSize" asp-route-searchString="@ViewData["CurrentFilter"]" asp-route-sortOrder="@ViewData["CurrentSort"]">Next</a>
            </li>
        </ul>
    </nav>
}
